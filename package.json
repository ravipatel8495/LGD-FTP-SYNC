{
  "name": "lgd-ftp-data-sync",
  "productName": "LGD FTP DATA SYNC",
  "version": "1.0.1",
  "description": "Watch a file or folder and auto-upload changes over FTP / FTPS / SFTP",
  "author": "LGD <lgd@augmont.com>",
  "homepage": "https://diamonds.augmont.com",
  "license": "MIT",
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "dist:win": "tauri build --bundles nsis,msi",
    "dist:mac": "tauri build --target universal-apple-darwin --bundles dmg,app --config signing.macos.adhoc.json",
    "dist:mac:arm": "tauri build --target aarch64-apple-darwin --bundles dmg,app --config signing.macos.adhoc.json",
    "dist:mac:intel": "tauri build --target x86_64-apple-darwin --bundles dmg,app --config signing.macos.adhoc.json",
    "dist:mac:internal": "bash scripts/build-macos-internal.sh",
    "sign:mac:internal": "bash scripts/sign-macos-adhoc.sh",
    "verify:mac": "bash scripts/verify-macos-signing.sh",
    "dist:linux": "tauri build --bundles deb,appimage",
    "dist:all": "tauri build",
    "certs": "bash scripts/create-self-signed-certs.sh",
    "sign:mac": "bash scripts/sign-macos-adhoc.sh",
    "dmg": "bash scripts/make-macos-dmg.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
